# Copiez en `.env.deploy` (non versionné) et renseignez vos valeurs.
# L'authentification se fait par clé SSH : aucun mot de passe ici.

HOSTINGER_HOST=srv-000.hstgr.io
HOSTINGER_USER=u000000000
HOSTINGER_PORT=65002
HOSTINGER_PATH=public_html/

# Facultatif : permet au script de vérifier les en-têtes après publication.
HOSTINGER_DOMAIN=chalk.exemple.fr
