{
  "name": "chalk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.18.0"
  },
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "pnpm --filter @chalk/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:watch": "pnpm --filter @chalk/core test:watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "generate:deploy": "node deploy/generate.mjs",
    "package:release": "bash scripts/package-release.sh",
    "verify:deployment": "bash scripts/verify-deployment.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.4",
    "eslint-plugin-vue": "^9.32.0",
    "vue-eslint-parser": "^9.4.3",
    "eslint-config-prettier": "^9.1.0"
  }
}
